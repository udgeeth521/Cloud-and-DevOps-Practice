#!/bin/bash

# Simple Log Cleanup Script
# Author: Beginner DevOps Journey

TARGET_DIR="/var/log"
DAYS_OLD=7

echo "Starting cleanup of logs older than $DAYS_OLD days in $TARGET_DIR..."

# Find and delete files older than specified days safely
find "$TARGET_DIR" -name "*.log" -type f -mtime +$DAYS_OLD -exec rm -f {} \;

echo "Cleanup complete!"